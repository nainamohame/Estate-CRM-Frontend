# Copy this file to client/.env and fill in your values.
#
# Only needed when the frontend is deployed SEPARATELY from the backend API
# (a split deploy). Point it at the API's own origin — no trailing slash,
# no /api suffix (the app adds that itself).
#
# Leave unset for local dev (Vite proxies /api to localhost:4000) or for a
# same-origin deploy where this server's own Express process serves the API.
VITE_API_URL=https://estate-crm-backend-0u4p.onrender.com
